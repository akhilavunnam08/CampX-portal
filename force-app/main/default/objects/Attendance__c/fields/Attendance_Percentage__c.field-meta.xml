<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Attendance_Percentage__c</fullName>
    <description>Monthly attendance percentage</description>
    <externalId>false</externalId>
    <formula>IF(Total_Working_Days__c > 0, Days_Present__c / Total_Working_Days__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Attendance Percentage</label>
    <precision>5</precision><scale>2</scale>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
    <unique>false</unique>
</CustomField>
